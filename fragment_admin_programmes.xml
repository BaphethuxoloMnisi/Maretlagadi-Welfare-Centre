<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- Splash -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.maretlagadi.welfarecentre.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action android:id="@+id/action_splash_to_login" app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph" app:popUpToInclusive="true" />
        <action android:id="@+id/action_splash_to_home" app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph" app:popUpToInclusive="true" />
    </fragment>

    <!-- Auth -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.maretlagadi.welfarecentre.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action android:id="@+id/action_login_to_register" app:destination="@id/registerFragment" />
        <action android:id="@+id/action_login_to_forgot" app:destination="@id/forgotPasswordFragment" />
        <action android:id="@+id/action_login_to_home" app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph" app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.maretlagadi.welfarecentre.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action android:id="@+id/action_register_to_login" app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment" app:popUpToInclusive="true" />
        <action android:id="@+id/action_register_to_home" app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph" app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.maretlagadi.welfarecentre.ui.auth.ForgotPasswordFragment"
        android:label="Forgot Password"
        tools:layout="@layout/fragment_forgot_password">
        <action android:id="@+id/action_forgot_to_login" app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment" app:popUpToInclusive="true" />
    </fragment>

    <!-- Main / bottom nav destinations: Home, Programmes, Volunteer, Calendar, Profile -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.maretlagadi.welfarecentre.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action android:id="@+id/action_home_to_events" app:destination="@id/eventsFragment" />
        <action android:id="@+id/action_home_to_contact" app:destination="@id/contactFragment" />
        <action android:id="@+id/action_home_to_donations" app:destination="@id/donationsFragment" />
        <action android:id="@+id/action_home_to_admin" app:destination="@id/adminDashboardFragment" />
        <action android:id="@+id/action_home_to_notifications" app:destination="@id/notificationsFragment" />
    </fragment>

    <fragment
        android:id="@+id/programmesFragment"
        android:name="com.maretlagadi.welfarecentre.ui.programmes.ProgrammesFragment"
        android:label="Programmes"
        tools:layout="@layout/fragment_programmes" />

    <fragment
        android:id="@+id/eventsFragment"
        android:name="com.maretlagadi.welfarecentre.ui.events.EventsFragment"
        android:label="Events"
        tools:layout="@layout/fragment_events" />

    <fragment
        android:id="@+id/volunteerFragment"
        android:name="com.maretlagadi.welfarecentre.ui.volunteer.VolunteerFragment"
        android:label="Volunteer"
        tools:layout="@layout/fragment_volunteer" />

    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.maretlagadi.welfarecentre.ui.calendarview.CalendarFragment"
        android:label="Calendar"
        tools:layout="@layout/fragment_calendar" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.maretlagadi.welfarecentre.ui.notifications.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.maretlagadi.welfarecentre.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action android:id="@+id/action_profile_to_login" app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph" app:popUpToInclusive="true" />
        <action android:id="@+id/action_profile_to_settings" app:destination="@id/settingsFragment" />
    </fragment>

    <!-- Secondary screens -->
    <fragment
        android:id="@+id/contactFragment"
        android:name="com.maretlagadi.welfarecentre.ui.contact.ContactFragment"
        android:label="Contact Us"
        tools:layout="@layout/fragment_contact" />

    <fragment
        android:id="@+id/donationsFragment"
        android:name="com.maretlagadi.welfarecentre.ui.donations.DonationsFragment"
        android:label="Donations"
        tools:layout="@layout/fragment_donations" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.maretlagadi.welfarecentre.ui.profile.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action android:id="@+id/action_settings_to_login" app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph" app:popUpToInclusive="true" />
    </fragment>

    <!-- Admin -->
    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.maretlagadi.welfarecentre.ui.admin.AdminDashboardFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin_dashboard">
        <action android:id="@+id/action_admin_to_users" app:destination="@id/adminUsersFragment" />
        <action android:id="@+id/action_admin_to_programmes" app:destination="@id/adminProgrammesFragment" />
        <action android:id="@+id/action_admin_to_events" app:destination="@id/adminEventsFragment" />
        <action android:id="@+id/action_admin_to_enquiries" app:destination="@id/adminEnquiriesFragment" />
        <action android:id="@+id/action_admin_to_activity" app:destination="@id/adminActivityFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminActivityFragment"
        android:name="com.maretlagadi.welfarecentre.ui.admin.AdminActivityFragment"
        android:label="User Activity"
        tools:layout="@layout/fragment_admin_activity" />

    <fragment
        android:id="@+id/adminUsersFragment"
        android:name="com.maretlagadi.welfarecentre.ui.admin.AdminUsersFragment"
        android:label="Manage Users"
        tools:layout="@layout/fragment_admin_list" />

    <fragment
        android:id="@+id/adminProgrammesFragment"
        android:name="com.maretlagadi.welfarecentre.ui.admin.AdminProgrammesFragment"
        android:label="Manage Programmes"
        tools:layout="@layout/fragment_admin_programmes" />

    <fragment
        android:id="@+id/adminEventsFragment"
        android:name="com.maretlagadi.welfarecentre.ui.admin.AdminEventsFragment"
        android:label="Manage Events"
        tools:layout="@layout/fragment_admin_events" />

    <fragment
        android:id="@+id/adminEnquiriesFragment"
        android:name="com.maretlagadi.welfarecentre.ui.admin.AdminEnquiriesFragment"
        android:label="Enquiries"
        tools:layout="@layout/fragment_admin_list" />

</navigation>
